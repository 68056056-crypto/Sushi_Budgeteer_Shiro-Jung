# Copy to .env locally; never commit an actual key.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
SUSHI_DATA_MODE=strict
# Optional absolute path. Default: data/menu.sqlite3 in this checkout.
# SUSHI_DB_PATH=/absolute/path/to/menu.sqlite3

# Optional custom executable; default tools/opa/opa (or opa.exe). Missing OPA denies recommendations.
# SUSHI_OPA_BINARY=/absolute/path/to/opa
